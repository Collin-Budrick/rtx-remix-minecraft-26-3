if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR AND PROJECT_NAME STREQUAL "RTXDI")
    function(renderer_lab_add_restir_adapter)
        get_target_property(sdk_source FullSample SOURCE_DIR)
        get_target_property(sdk_sources FullSample SOURCES)
        get_target_property(sdk_includes FullSample INCLUDE_DIRECTORIES)
        get_target_property(sdk_definitions FullSample COMPILE_DEFINITIONS)
        get_target_property(sdk_links FullSample LINK_LIBRARIES)
        set(adapter_root "${RENDERER_EXPERIMENT_ROOT}/restir")
        include("${adapter_root}/AdaptSceneRenderer.cmake")
        set(adapter_sources)
        foreach(source IN LISTS sdk_sources)
            get_filename_component(source_absolute "${source}" ABSOLUTE BASE_DIR "${sdk_source}")
            if(NOT source_absolute STREQUAL "${sdk_source}/main.cpp" AND NOT source_absolute STREQUAL "${sdk_source}/App/SceneRenderer.cpp")
                list(APPEND adapter_sources "${source_absolute}")
            endif()
        endforeach()
        if(NOT TARGET RendererLabScene)
            add_library(RendererLabScene STATIC
                "${RENDERER_LAB_ROOT}/src/ScenePacket.cpp"
                "${RENDERER_LAB_ROOT}/src/GltfExport.cpp")
            target_compile_features(RendererLabScene PUBLIC cxx_std_20)
            target_include_directories(RendererLabScene PUBLIC "${RENDERER_LAB_ROOT}/include")
            target_include_directories(RendererLabScene PRIVATE "${RENDERER_LAB_ROOT}/third_party")
            target_compile_definitions(RendererLabScene PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
            target_link_libraries(RendererLabScene PUBLIC windowscodecs ole32)
        endif()
        add_executable(RendererLabReSTIRPT WIN32 "${adapter_root}/RestirMain.cpp" "${replay_renderer}" ${adapter_sources})
        target_include_directories(RendererLabReSTIRPT PRIVATE ${sdk_includes} "${sdk_source}" "${sdk_source}/App" "${adapter_root}" "${RENDERER_LAB_ROOT}/third_party")
        if(sdk_definitions)
            target_compile_definitions(RendererLabReSTIRPT PRIVATE ${sdk_definitions})
        endif()
        target_compile_definitions(RendererLabReSTIRPT PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_link_libraries(RendererLabReSTIRPT PRIVATE ${sdk_links} RendererLabScene)
        add_dependencies(RendererLabReSTIRPT FullSampleShaders)
        foreach(name DLSS_SHARED_LIBRARY_PATH DLSS_RR_SHARED_LIBRARY_PATH)
            get_directory_property(dll_path DIRECTORY "${sdk_source}" DEFINITION ${name})
            if(dll_path)
                add_custom_command(TARGET RendererLabReSTIRPT POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${dll_path}" "$<TARGET_FILE_DIR:RendererLabReSTIRPT>/")
            endif()
        endforeach()
    endfunction()
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL renderer_lab_add_restir_adapter)
endif()
